{
  "name": "puzzlebeyond",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vercel": "next dev",
    "build:vercel": "next build",
    "start:vercel": "next start",
    "dev:sites": "vinext dev",
    "build:sites": "vinext build",
    "start:sites": "vinext start",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental false",
    "typecheck:vercel": "tsc --project tsconfig.vercel.json --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "type": "module"
}
